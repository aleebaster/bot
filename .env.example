# ============================================================================
# CRYPTO FUTURES SIGNAL BOT - environment template
# Copy to .env and fill in your values. NEVER commit .env.
# Public market data works with empty Binance keys. No trading permissions needed.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_TELEGRAM_IDS=

# --- Binance (OPTIONAL - public data needs no keys, no trading rights) ------
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGE_ID=binance
FUTURES=true
ENABLE_RATE_LIMIT=true

# --- Risk -------------------------------------------------------------------
ACCOUNT_BALANCE=1000
RISK_PER_TRADE=0.005
LEVERAGE=1
MAX_CONCURRENT_IDEAS=3
MIN_RISK_REWARD=2.0
MIN_SIGNAL_SCORE=80

# --- Cost model -------------------------------------------------------------
TAKER_FEE=0.0004
MAKER_FEE=0.0002
SLIPPAGE=0.0005
FUNDING_PER_8H=0.0001
MAX_HOLDING_BARS_FUNDING=24

# --- Market data ------------------------------------------------------------
OHLCV_LIMIT=400
MIN_VOLUME_USDT=5000000
MAX_QUOTE_AGE_SECONDS=180
SCAN_INTERVAL_SECONDS=60
# Poll interval for a newly closed candle (triggers an immediate scan)
SCAN_CANDLE_CLOSE_POLL_SECONDS=5
# Minimum minutes between two signals for the same symbol (dedup/cooldown)
SIGNAL_COOLDOWN_MINUTES=240
# Bounded parallelism for REST backfill and per-symbol analysis (1-16)
MAX_CONCURRENT_SYMBOLS=4
WS_ENABLED=true
TOP_N_SCANNER=20

# --- Runtime ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db
LOG_LEVEL=INFO
# SIGNAL_ONLY=true is the default mode: analysis + Telegram signals, no orders.
SIGNAL_ONLY=true
# Optional internal simulation. Not required for signal delivery.
PAPER_TRADING=false
DRY_RUN=true
# Comma-separated symbols; leave empty for the built-in default watchlist
WATCHLIST=
